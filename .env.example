# Database Configuration
# Must match POSTGRES_* below. Docker Compose maps Postgres to host port 5432.
DATABASE_URL=postgresql://postgres:your_secure_password@localhost:5432/fraud_investigator
# SKIP_DATABASE_INIT=1 — do not connect to Postgres (ORM off; file-backed demo data still works).
# REQUIRE_DATABASE=1 — exit startup if Postgres is unreachable (recommended in production).
SKIP_DATABASE_INIT=0
REQUIRE_DATABASE=0
POSTGRES_DB=fraud_investigator
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379

# LLM API Keys (Required for AI functionality)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Security (Generate a strong secret key)
SECRET_KEY=your_very_long_and_secure_secret_key_here

# Application Settings
ENVIRONMENT=development
DEBUG=false

# Monitoring (Optional)
SENTRY_DSN=your_sentry_dsn_here

# LangSmith Configuration (Optional)
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=fraud-investigator
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING=true
