.vscode/
.idea/
*.swp
*.swo

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Logs & local run output ───────────────────────────────────────────────────
*.log
logs/
tmp/
temp/
scratch/
exports/
downloads/

# ── Local databases & dumps (may contain PII from dev) ────────────────────────
*.db
*.sqlite
*.sqlite3
dump.sql
*.dump

# ── Docker overrides (often contain local paths / secrets) ───────────────────
*.override.yml

# ── Tooling / specs (local only) ──────────────────────────────────────────────
.kiro/

# ── Documentation: tracked vs local-only ─────────────────────────────────────
# Tracked: README, API docs in repo root. Ignored below: drafts, internal notes,
# generated trees, and paths that should not leave your machine.
docs/
local-docs/
private-docs/
notes/
*_LOCAL.md
*_PRIVATE.md
INTERNAL*.md
DEMO_GUIDE.md
README_DEMO.md
SIMPLE_DEMO_FLOW.md
